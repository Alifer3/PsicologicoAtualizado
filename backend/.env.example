PORT=3000
APP_URL=http://localhost:5500

# JWT - OBRIGATÓRIO trocar em produção!
JWT_SECRET=troque_esta_chave_em_producao_use_openssl_rand_hex_32

# Origens permitidas pelo CORS (separar por vírgula)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Pagamentos: escolha stripe, mercadopago ou mock
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx
MERCADO_PAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxx

# Google Calendar/Meet: use mock para testes locais sem credenciais
GOOGLE_MEET_PROVIDER=mock
GOOGLE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=primary

# PostgreSQL Render
DATABASE_URL=postgres://usuario:senha@host:5432/banco
NODE_ENV=development
